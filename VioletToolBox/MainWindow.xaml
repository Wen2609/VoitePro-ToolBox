                                               VerticalAlignment="Center"
                                               Margin="0,0,8,0"
                                               FontSize="12"
                                               Foreground="#FF333333"
                                               FontWeight="Medium"/>
                                </Grid>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ProgressBar.Style>
    </ProgressBar>
</Grid>
