<Grid.RowDefinitions>
    <RowDefinition Height="Auto"/>
    <RowDefinition Height="*"/>
    <RowDefinition Height="Auto"/>
    <RowDefinition Height="Auto"/>
    <RowDefinition Height="Auto"/>
</Grid.RowDefinitions>

    <!-- ===== 页头 ===== -->
    <Grid Grid.Row="0" Margin="6,10,6,8">
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
            <Border Width="40" Height="40" CornerRadius="12" Background="#FF007AFF">
                <svg:SvgViewbox Source="images/white/adb.svg" Width="21" Height="21"/>
            </Border>
            <StackPanel VerticalAlignment="Center" Margin="12,0,0,0">
                <TextBlock Text="可视刷写" FontSize="20" FontWeight="Bold" Foreground="#FF1D1D1F"/>
                <TextBlock Text="Fastboot 分区可视化读写" FontSize="12" Foreground="#FF8E8E93" Margin="0,2,0,0"/>
            </StackPanel>
        </StackPanel>
    </Grid>

    <!-- ===== 主区域：分区表 + 执行日志 ===== -->
    <Grid Grid.Row="1" Margin="0,0,0,8">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="7*"/>
            <ColumnDefinition Width="3*"/>
        </Grid.ColumnDefinitions>

        <!-- 分区表 -->
        <GroupBox Grid.Column="0"
                  Margin="0,0,6,0"
                  Style="{StaticResource FastbootCardGroupBoxStyle}"
                  Padding="10,12,10,10">
            <GroupBox.Header>
                <StackPanel Orientation="Horizontal" Background="Transparent">
                    <svg:SvgViewbox Source="images/xinpianshuju.svg" Width="15" Height="15" Margin="0,0,7,0" VerticalAlignment="Center"/>
                    <TextBlock Text="分区表" VerticalAlignment="Center"/>
                </StackPanel>
            </GroupBox.Header>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- 工具行：搜索 / 生成XML / 保护分区 / 已选统计 -->
                <Grid Grid.Row="0" Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0"
                            Height="28"
                            Width="190"
                            Padding="8,0"
                            Background="#FFFFFFFF"
                            BorderBrush="#FFE1E1E1"
                            BorderThickness="1"
                            CornerRadius="5">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="21"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0"
                                       Text="&#xE721;"
                                       FontFamily="Segoe MDL2 Assets"
                                       FontSize="13"
                                       Foreground="#AEAEB2"
                                       VerticalAlignment="Center"/>
                            <TextBox x:Name="PartitionSearchTextBox"
                                     Grid.Column="1"
                                     Padding="2,0,0,0"
                                     BorderThickness="0"
                                     Background="Transparent"
                                     VerticalContentAlignment="Center"
                                     FontSize="12"
                                     Foreground="#1D1D1F"
                                     ToolTip="搜索分区名称"
                                     TextChanged="PartitionSearchTextBox_TextChanged"
                                     KeyDown="PartitionSearchTextBox_KeyDown"/>
                            <TextBlock Grid.Column="1"
                                       Margin="4,0,0,0"
                                       Text="请输入分区名称..."
                                       FontSize="12"
                                       Foreground="#AEAEB2"
                                       VerticalAlignment="Center"
                                       IsHitTestVisible="False">
                                <TextBlock.Style>
                                    <Style TargetType="{x:Type TextBlock}">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Text, ElementName=PartitionSearchTextBox}" Value="">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                    </Border>

                    <CheckBox x:Name="GenerateRawProgramXmlCheckBox"
                              Grid.Column="1"
                              Content="生成XML"
                              IsChecked="True"
                              Margin="14,0,0,0"
                              FontSize="12"
                              VerticalAlignment="Center"
                              ToolTip="回读完成后，生成 rawprogram*.xml文件"/>

                    <CheckBox x:Name="ProtectPartitionCheckBox"
                              Grid.Column="2"
                              Content="保护分区"
                              IsChecked="True"
                              Margin="14,0,0,0"
                              FontSize="12"
                              VerticalAlignment="Center"
                              Checked="ProtectPartitionCheckBox_Checked"
                              ToolTip="保护基带分区和数据分区不被写入"/>

                    <TextBlock x:Name="PartitionSelectionSummaryTextBlock"
                               Grid.Column="3"
                               Margin="14,0,0,0"
                               HorizontalAlignment="Right"
                               VerticalAlignment="Center"
                               FontFamily="pack://siteoforigin:,,,/fonts/OPPO_Sans_4.0.ttf#OPPO Sans 4.0"
                               FontSize="11"
                               FontWeight="Medium"
                               Foreground="#6E6E73"
                               Text="已选 0/0 · 0 B"
                               Tag="已选择 0 / 0  |  总计 0 B"
                               TextTrimming="CharacterEllipsis"
                               ToolTip="{Binding Tag, RelativeSource={RelativeSource Self}}"/>
                </Grid>

                <!-- 分区数据表 -->
                <DataGrid x:Name="PartitionTableDataGrid"
                          Grid.Row="1"
                          AutoGenerateColumns="False"
                          HeadersVisibility="Column"
                          Foreground="#1D1D1F"
                          Background="#FFFFFFFF"
                          FontFamily="pack://siteoforigin:,,,/fonts/OPPO_Sans_4.0.ttf#OPPO Sans 4.0"
                          FontSize="12"
                          IsSynchronizedWithCurrentItem="True"
                          RowHeight="29"
                          AlternationCount="2"
                          SelectionChanged="PartitionTableDataGrid_SelectionChanged"
                          MouseDoubleClick="PartitionTableDataGrid_MouseDoubleClick"
                          BorderBrush="#FFE9E9E9"
                          BorderThickness="1"
                          GridLinesVisibility="None"
                          HorizontalGridLinesBrush="Transparent"
                          VerticalGridLinesBrush="Transparent"
                          HorizontalScrollBarVisibility="Hidden"
                          VerticalScrollBarVisibility="Auto" VirtualizingStackPanel.IsVirtualizing="True" VirtualizingStackPanel.VirtualizationMode="Recycling" ScrollViewer.CanContentScroll="True">
                    <DataGrid.Resources>
                        <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#FF007AFF"/>
                        <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="#FFFFFFFF"/>
                        <Style x:Key="FastbootPartitionTextCellStyle" TargetType="{x:Type TextBlock}">
                            <Setter Property="HorizontalAlignment" Value="Stretch"/>
                            <Setter Property="VerticalAlignment" Value="Center"/>
                            <Setter Property="TextAlignment" Value="Center"/>
                        </Style>
                    </DataGrid.Resources>
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="选择" Width="40">
                            <DataGridTemplateColumn.HeaderTemplate>
                                <DataTemplate>
                                    <CheckBox x:Name="PartitionSelectAllCheckBox" Content="" Checked="PartitionSelectAllCheckBox_Checked" Unchecked="PartitionSelectAllCheckBox_Unchecked" HorizontalAlignment="Center"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.HeaderTemplate>
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Grid Width="18"
                                          Height="18"
                                          HorizontalAlignment="Center">
                                        <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                  Click="PartitionSelectionCheckBox_Click"
                                                  Width="16"
                                                  Height="16"
                                                  HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"
                                                  Focusable="False">
                                            <CheckBox.Style>
                                                <Style TargetType="{x:Type CheckBox}"
                                                       BasedOn="{StaticResource {x:Type CheckBox}}">
                                                    <Style.Triggers>
                                                        <MultiDataTrigger>
                                                            <MultiDataTrigger.Conditions>
                                                                <Condition Binding="{Binding ElementName=ProtectPartitionCheckBox, Path=IsChecked}" Value="True"/>
                                                                <Condition Binding="{Binding IsBasebandFingerprintProtected}" Value="True"/>
                                                            </MultiDataTrigger.Conditions>
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                            <Setter Property="IsEnabled" Value="False"/>
                                                        </MultiDataTrigger>
                                                        <MultiDataTrigger>
                                                            <MultiDataTrigger.Conditions>
                                                                <Condition Binding="{Binding ElementName=ProtectPartitionCheckBox, Path=IsChecked}" Value="True"/>
                                                                <Condition Binding="{Binding IsAdbDataProtected}" Value="True"/>
                                                                <Condition Binding="{Binding ElementName=BottomConnectionTypeText, Path=Tag.RawText}" Value="系统"/>
                                                            </MultiDataTrigger.Conditions>
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                            <Setter Property="IsEnabled" Value="False"/>
                                                        </MultiDataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </CheckBox.Style>
                                        </CheckBox>
                                        <svg:SvgViewbox Source="images/dunpai.svg"
                                                        Width="16"
                                                        Height="16"
                                                        HorizontalAlignment="Center"
                                                        VerticalAlignment="Center"
                                                        ToolTip="该分区已受保护，当前禁止写入">
                                            <svg:SvgViewbox.Style>
                                                <Style TargetType="{x:Type svg:SvgViewbox}">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <MultiDataTrigger>
                                                            <MultiDataTrigger.Conditions>
                                                                <Condition Binding="{Binding ElementName=ProtectPartitionCheckBox, Path=IsChecked}" Value="True"/>
                                                                <Condition Binding="{Binding IsBasebandFingerprintProtected}" Value="True"/>
                                                            </MultiDataTrigger.Conditions>
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </MultiDataTrigger>
                                                        <MultiDataTrigger>
                                                            <MultiDataTrigger.Conditions>
                                                                <Condition Binding="{Binding ElementName=ProtectPartitionCheckBox, Path=IsChecked}" Value="True"/>
                                                                <Condition Binding="{Binding IsAdbDataProtected}" Value="True"/>
                                                                <Condition Binding="{Binding ElementName=BottomConnectionTypeText, Path=Tag.RawText}" Value="系统"/>
                                                            </MultiDataTrigger.Conditions>
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </MultiDataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </svg:SvgViewbox.Style>
                                        </svg:SvgViewbox>
                                    </Grid>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="名称"
                                            Binding="{Binding PartitionName}"
                                            ElementStyle="{StaticResource FastbootPartitionTextCellStyle}"
                                            IsReadOnly="True"
                                            Width="140" />
                        <DataGridTextColumn Header="大小"
                                            Binding="{Binding PartitionSize}"
                                            ElementStyle="{StaticResource FastbootPartitionTextCellStyle}"
                                            IsReadOnly="True"
                                            Width="100" />
