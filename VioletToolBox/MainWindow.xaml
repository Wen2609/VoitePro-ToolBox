                                                <GradientStop Offset="1" Color="#FF007AFF" />
                                            </LinearGradientBrush>
                                        </Border.Background>
                                    </Border>
                                    <TextBlock Text="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}"
                                               HorizontalAlignment="Left"
                                               VerticalAlignment="Center"
                                               Margin="8,0,0,0"
                                               FontSize="12"
                                               Foreground="#FF333333"
                                               FontWeight="Medium"/>
