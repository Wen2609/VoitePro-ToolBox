                                        <svg:SvgViewbox Source="images/white/ai.svg" Width="21" Height="21"/>
                                    </Border>
                                    <StackPanel VerticalAlignment="Center" Margin="12,0,0,0">
                                        <TextBlock Text="AI助手" FontSize="20" FontWeight="Bold" Foreground="#FF1D1D1F"/>
