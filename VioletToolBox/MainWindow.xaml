                        Width="96"
                        Height="30"
                        Margin="0,0,8,0"
                        HorizontalContentAlignment="Center"/>
                <Button x:Name="ErasePartitionButton"
                        Grid.Column="2"
                        Content="擦除分区"
                        Style="{StaticResource FastbootSecondaryButtonStyle}"
