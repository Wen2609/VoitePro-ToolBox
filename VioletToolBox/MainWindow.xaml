                                </hc:SideMenuItem>
                            </hc:SideMenu>
                        </ScrollViewer>
                    </Border>
                    <Grid
					Grid.Column="1"
					Margin="5,12,20,8">
                    <Grid>
                        <Grid
				Name="HomeView"
				VerticalAlignment="Top"
				Visibility="Collapsed">
<Grid.Resources>
                                <Style x:Key="HomeCardStyle" TargetType="Border">
                                    <Setter Property="Background" Value="#FFFFFFFF"/>
                                    <Setter Property="BorderBrush" Value="#FFE5E5EA"/>
                                    <Setter Property="BorderThickness" Value="1"/>
                                    <Setter Property="CornerRadius" Value="12"/>
                                    <Setter Property="Padding" Value="14"/>
                                </Style>
                                <Style x:Key="HomePanelTitleStyle" TargetType="TextBlock">
                                    <Setter Property="FontSize" Value="15"/>
                                    <Setter Property="FontWeight" Value="Bold"/>
                                    <Setter Property="Foreground" Value="#FF1D1D1F"/>
                                </Style>
                                <Style x:Key="HomePanelSubtitleStyle" TargetType="TextBlock">
                                    <Setter Property="FontSize" Value="11"/>
                                    <Setter Property="Foreground" Value="#FF8E8E93"/>
                                    <Setter Property="Margin" Value="0,3,0,0"/>
                                </Style>
                                <Style x:Key="HomeActionButtonStyle" TargetType="Button">
                                    <Setter Property="Height" Value="36"/>
                                    <Setter Property="Margin" Value="0"/>
                                    <Setter Property="Padding" Value="10,0"/>
                                    <Setter Property="Background" Value="#FF007AFF"/>
                                    <Setter Property="Foreground" Value="White"/>
                                    <Setter Property="BorderThickness" Value="0"/>
                                    <Setter Property="FontSize" Value="13"/>
                                    <Setter Property="FontWeight" Value="Medium"/>
                                    <Setter Property="Cursor" Value="Hand"/>
                                    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="{x:Type Button}">
                                                <Border x:Name="b" Background="{TemplateBinding Background}" CornerRadius="6">
                                                    <ContentPresenter TextElement.Foreground="{TemplateBinding Foreground}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Trigger.EnterActions>
                                                            <BeginStoryboard>
                                                                <Storyboard>
                                                                    <ColorAnimation Storyboard.TargetName="b"
                                                                                    Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)"
                                                                                    To="#FF0066D6" Duration="0:0:0.15">
                                                                        <ColorAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></ColorAnimation.EasingFunction>
                                                                    </ColorAnimation>
                                                                </Storyboard>
                                                            </BeginStoryboard>
                                                        </Trigger.EnterActions>
                                                        <Trigger.ExitActions>
                                                            <BeginStoryboard>
                                                                <Storyboard>
                                                                    <ColorAnimation Storyboard.TargetName="b"
                                                                                    Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)"
                                                                                    Duration="0:0:0.2">
                                                                        <ColorAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></ColorAnimation.EasingFunction>
                                                                    </ColorAnimation>
                                                                </Storyboard>
                                                            </BeginStoryboard>
                                                        </Trigger.ExitActions>
                                                    </Trigger>
                                                    <Trigger Property="IsPressed" Value="True">
                                                        <Trigger.EnterActions>
                                                            <BeginStoryboard>
                                                                <Storyboard>
                                                                    <ColorAnimation Storyboard.TargetName="b"
                                                                                    Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)"
                                                                                    To="#FF004C9E" Duration="0:0:0.08"/>
                                                                </Storyboard>
                                                            </BeginStoryboard>
                                                        </Trigger.EnterActions>
                                                        <Trigger.ExitActions>
                                                            <BeginStoryboard>
                                                                <Storyboard>
                                                                    <ColorAnimation Storyboard.TargetName="b"
                                                                                    Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)"
                                                                                    To="#FF0066D6" Duration="0:0:0.14">
                                                                        <ColorAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></ColorAnimation.EasingFunction>
                                                                    </ColorAnimation>
                                                                </Storyboard>
                                                            </BeginStoryboard>
                                                        </Trigger.ExitActions>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                                <Style x:Key="HomeToolButtonStyle" TargetType="Button">
                                    <Setter Property="Height" Value="38"/>
                                    <Setter Property="Margin" Value="0"/>
                                    <Setter Property="Padding" Value="10,0"/>
                                    <Setter Property="Background" Value="#FFFFFFFF"/>
                                    <Setter Property="Foreground" Value="#FF1D1D1F"/>
                                    <Setter Property="BorderBrush" Value="#FFC7C7CC"/>
                                    <Setter Property="BorderThickness" Value="1"/>
                                    <Setter Property="FontSize" Value="13"/>
                                    <Setter Property="FontWeight" Value="Medium"/>
                                    <Setter Property="Cursor" Value="Hand"/>
                                    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="{x:Type Button}">
                                                <Border x:Name="b" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6">
                                                    <ContentPresenter TextElement.Foreground="{TemplateBinding Foreground}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Trigger.EnterActions>
                                                            <BeginStoryboard>
                                                                <Storyboard>
                                                                    <ColorAnimation Storyboard.TargetName="b"
                                                                                    Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)"
                                                                                    To="#FFE8F0FF" Duration="0:0:0.15">
                                                                        <ColorAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></ColorAnimation.EasingFunction>
                                                                    </ColorAnimation>
                                                                </Storyboard>
                                                            </BeginStoryboard>
                                                        </Trigger.EnterActions>
                                                        <Trigger.ExitActions>
                                                            <BeginStoryboard>
                                                                <Storyboard>
                                                                    <ColorAnimation Storyboard.TargetName="b"
                                                                                    Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)"
                                                                                    Duration="0:0:0.2">
                                                                        <ColorAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></ColorAnimation.EasingFunction>
                                                                    </ColorAnimation>
                                                                </Storyboard>
                                                            </BeginStoryboard>
                                                        </Trigger.ExitActions>
                                                    </Trigger>
                                                    <Trigger Property="IsPressed" Value="True">
                                                        <Trigger.EnterActions>
                                                            <BeginStoryboard>
                                                                <Storyboard>
                                                                    <ColorAnimation Storyboard.TargetName="b"
                                                                                    Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)"
                                                                                    To="#FFE5E5EA" Duration="0:0:0.08"/>
                                                                </Storyboard>
                                                            </BeginStoryboard>
                                                        </Trigger.EnterActions>
                                                        <Trigger.ExitActions>
                                                            <BeginStoryboard>
                                                                <Storyboard>
                                                                    <ColorAnimation Storyboard.TargetName="b"
                                                                                    Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)"
                                                                                    To="#FFE8F0FF" Duration="0:0:0.14">
                                                                        <ColorAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></ColorAnimation.EasingFunction>
                                                                    </ColorAnimation>
                                                                </Storyboard>
                                                            </BeginStoryboard>
                                                        </Trigger.ExitActions>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                                <Style x:Key="HomeSwitchStyle" TargetType="{x:Type ToggleButton}">
                                    <Setter Property="Focusable" Value="False" />
                                    <Setter Property="Cursor" Value="Hand"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="{x:Type ToggleButton}">
                                                <Border x:Name="PART_Border"
                                                        Width="44"
                                                        Height="24"
                                                        Background="#FFD1D1D6"
                                                        CornerRadius="12">
                                                    <VisualStateManager.VisualStateGroups>
                                                        <VisualStateGroup x:Name="CheckStates">
                                                            <VisualState x:Name="Checked">
                                                                <Storyboard>
                                                                    <DoubleAnimation Storyboard.TargetName="PART_Ellipse"
                                                                                     Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"
                                                                                     To="22"
                                                                                     Duration="00:00:0.18"/>
                                                                </Storyboard>
                                                            </VisualState>
                                                            <VisualState x:Name="Unchecked">
                                                                <Storyboard>
                                                                    <DoubleAnimation Storyboard.TargetName="PART_Ellipse"
                                                                                     Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"
                                                                                     To="0"
                                                                                     Duration="00:00:0.18"/>
                                                                </Storyboard>
                                                            </VisualState>
                                                            <VisualState x:Name="Indeterminate" />
                                                        </VisualStateGroup>
                                                    </VisualStateManager.VisualStateGroups>
                                                    <Ellipse x:Name="PART_Ellipse"
                                                             Width="18"
                                                             Height="18"
                                                             Margin="3,0"
                                                             VerticalAlignment="Center"
                                                             HorizontalAlignment="Left"
                                                             Fill="White">
                                                        <Ellipse.RenderTransform>
                                                            <TranslateTransform/>
                                                        </Ellipse.RenderTransform>
                                                    </Ellipse>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsChecked" Value="True">
                                                        <Setter Property="Background" TargetName="PART_Border" Value="#FF1D1D1F"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </Grid.Resources>
                            <StackPanel Margin="0,0,0,8">

                                    <!-- 页面标题 -->
                                    <Grid Margin="2,0,0,10">
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                                            <Border Width="40" Height="40" CornerRadius="12" Background="#FF007AFF">
                                                <svg:SvgViewbox Source="images/white/zhuye.svg" Width="21" Height="21"/>
                                            </Border>
                                            <StackPanel VerticalAlignment="Center" Margin="12,0,0,0">
                                                <TextBlock Text="主页" FontSize="20" FontWeight="Bold" Foreground="#FF1D1D1F"/>
                                                <TextBlock Text="设备状态与快捷操作" FontSize="12" Foreground="#FF8E8E93" Margin="0,2,0,0"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </Grid>

                                    <!-- 第一行：设备信息 + 电池/存储 -->
                                    <Grid Margin="0,0,0,14">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="1.8*" />
                                            <ColumnDefinition Width="14" />
                                            <ColumnDefinition Width="1*" />
                                        </Grid.ColumnDefinitions>

                                        <Border Grid.Column="0" Style="{StaticResource HomeCardStyle}">
                                            <StackPanel>
                                                <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                                                    <Border Width="28" Height="28" CornerRadius="8" Background="#FFE8F0FF">
                                                        <svg:SvgViewbox Source="images/android.svg" Width="17" Height="17"/>
                                                    </Border>
                                                    <TextBlock Text="设备信息" Style="{StaticResource HomePanelTitleStyle}" VerticalAlignment="Center" Margin="10,0,0,0"/>
                                                </StackPanel>
                                                <Grid Margin="0,2,0,0">
                                                    <Grid.Resources>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="ToolTip" Value="单击复制"/>
                                                            <Setter Property="ToolTipService.InitialShowDelay" Value="0"/>
                                                            <Setter Property="ToolTipService.ShowDuration" Value="2000"/>
                                                            <Setter Property="Cursor" Value="Hand"/>
                                                            <EventSetter Event="MouseLeftButtonDown" Handler="CopyTextBlockContent"/>
                                                        </Style>
                                                    </Grid.Resources>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="102" />
                                                        <ColumnDefinition Width="154" />
                                                        <ColumnDefinition Width="98" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="Auto" />
                                                    </Grid.RowDefinitions>
                                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="设备状态:" FontWeight="SemiBold" Foreground="#FF8E8E93" VerticalAlignment="Center" Margin="0,5,10,5" />
                                                    <TextBlock x:Name="DeviceStatusText" Grid.Row="0" Grid.Column="1" Text="检测中..." VerticalAlignment="Center" Foreground="#FF1D1D1F" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Grid.Row="0" Grid.Column="2" Text="A/B分区:" FontWeight="SemiBold" Foreground="#FF8E8E93" VerticalAlignment="Center" Margin="12,5,10,5" />
                                                    <TextBlock x:Name="ABPartitionText" Grid.Row="0" Grid.Column="3" Text="--" VerticalAlignment="Center" Foreground="#FF1D1D1F" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />

                                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="连接类型:" FontWeight="SemiBold" Foreground="#FF8E8E93" VerticalAlignment="Center" Margin="0,5,10,5" />
                                                    <TextBlock x:Name="ConnectionTypeText" Grid.Row="1" Grid.Column="1" Text="--" VerticalAlignment="Center" Foreground="#FF1D1D1F" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Grid.Row="1" Grid.Column="2" Text="CPU厂家:" FontWeight="SemiBold" Foreground="#FF8E8E93" VerticalAlignment="Center" Margin="12,5,10,5" />
                                                    <TextBlock x:Name="CpuManufacturerText" Grid.Row="1" Grid.Column="3" Text="--" VerticalAlignment="Center" Foreground="#FF1D1D1F" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />

                                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="设备序列号:" FontWeight="SemiBold" Foreground="#FF8E8E93" VerticalAlignment="Center" Margin="0,5,10,5" />
                                                    <TextBlock x:Name="DeviceSerialText" Grid.Row="2" Grid.Column="1" Text="--" VerticalAlignment="Center" Foreground="#FF1D1D1F" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Grid.Row="2" Grid.Column="2" Text="CPU代号:" FontWeight="SemiBold" Foreground="#FF8E8E93" VerticalAlignment="Center" Margin="12,5,10,5" />
                                                    <TextBlock x:Name="CpuCodeNameText" Grid.Row="2" Grid.Column="3" Text="--" VerticalAlignment="Center" Foreground="#FF1D1D1F" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />

                                                    <TextBlock Grid.Row="3" Grid.Column="0" Text="设备名称:" FontWeight="SemiBold" Foreground="#FF8E8E93" VerticalAlignment="Center" Margin="0,5,10,5" />
                                                    <TextBlock x:Name="DeviceModelText" Grid.Row="3" Grid.Column="1" Text="--" VerticalAlignment="Center" Foreground="#FF1D1D1F" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Grid.Row="3" Grid.Column="2" Text="CPU名称:" FontWeight="SemiBold" Foreground="#FF8E8E93" VerticalAlignment="Center" Margin="12,5,10,5" />
                                                    <TextBlock x:Name="CpuNameText" Grid.Row="3" Grid.Column="3" Text="--" VerticalAlignment="Center" Foreground="#FF1D1D1F" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />

                                                    <TextBlock Grid.Row="4" Grid.Column="0" Text="设备代号:" FontWeight="SemiBold" Foreground="#FF8E8E93" VerticalAlignment="Center" Margin="0,5,10,5" />
                                                    <TextBlock x:Name="DeviceCodeText" Grid.Row="4" Grid.Column="1" Text="--" VerticalAlignment="Center" Foreground="#FF1D1D1F" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Grid.Row="4" Grid.Column="2" Text="操作系统:" FontWeight="SemiBold" Foreground="#FF8E8E93" VerticalAlignment="Center" Margin="12,5,10,5" />
                                                    <TextBlock x:Name="WindowsVersionText" Grid.Row="4" Grid.Column="3" Text="--" VerticalAlignment="Center" Foreground="#FF1D1D1F" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />

                                                    <TextBlock Grid.Row="5" Grid.Column="0" Text="安卓版本:" FontWeight="SemiBold" Foreground="#FF8E8E93" VerticalAlignment="Center" Margin="0,5,10,5" />
                                                    <TextBlock x:Name="AndroidVersionText" Grid.Row="5" Grid.Column="1" Text="--" VerticalAlignment="Center" Foreground="#FF1D1D1F" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Grid.Row="5" Grid.Column="2" Text="SELinux:" FontWeight="SemiBold" Foreground="#FF8E8E93" VerticalAlignment="Center" Margin="12,5,10,5" />
                                                    <TextBlock x:Name="SelinuxStatusText" Grid.Row="5" Grid.Column="3" Text="--" VerticalAlignment="Center" Foreground="#FF1D1D1F" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />

                                                    <TextBlock Grid.Row="6" Grid.Column="0" Text="解锁状态:" FontWeight="SemiBold" Foreground="#FF8E8E93" VerticalAlignment="Center" Margin="0,5,10,5" />
                                                    <TextBlock x:Name="UnlockStatusText" Grid.Row="6" Grid.Column="1" Text="--" VerticalAlignment="Center" Foreground="#FF1D1D1F" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />

                                                    <TextBlock Grid.Row="7" Grid.Column="0" Text="版本信息:" FontWeight="SemiBold" Foreground="#FF8E8E93" VerticalAlignment="Center" Margin="0,5,10,5" />
                                                    <TextBlock x:Name="VersionInfoText" Grid.Row="7" Grid.Column="1" Text="--" VerticalAlignment="Center" Foreground="#FF1D1D1F" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Grid.ColumnSpan="3" />

                                                    <TextBlock Grid.Row="8" Grid.Column="0" Text="内核版本:" FontWeight="SemiBold" Foreground="#FF8E8E93" VerticalAlignment="Center" Margin="0,5,10,5" />
                                                    <TextBlock x:Name="KernelVersionText" Grid.Row="8" Grid.Column="1" Text="--" VerticalAlignment="Center" Foreground="#FF1D1D1F" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Grid.ColumnSpan="3" />

                                                    <TextBlock Grid.Row="9" Grid.Column="0" Text="构建日期:" FontWeight="SemiBold" Foreground="#FF8E8E93" VerticalAlignment="Center" Margin="0,5,10,5" />
                                                    <TextBlock x:Name="BuildDateText" Grid.Row="9" Grid.Column="1" Text="--" VerticalAlignment="Center" Foreground="#FF1D1D1F" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Grid.ColumnSpan="3" />
                                                </Grid>
                                            </StackPanel>
                                        </Border>

                                        <Grid Grid.Column="2">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="14" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>

                                            <Border Grid.Row="0" Style="{StaticResource HomeCardStyle}">
                                                <StackPanel>
                                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                                        <Border Width="28" Height="28" CornerRadius="8" Background="#FFE8F0FF">
                                                            <svg:SvgViewbox Source="images/shandian.svg" Width="16" Height="16"/>
                                                        </Border>
                                                        <TextBlock Style="{StaticResource HomePanelTitleStyle}" Text="电池状态" VerticalAlignment="Center" Margin="10,0,0,0"/>
                                                    </StackPanel>
                                                    <test1:HorizontalBattery x:Name="BatteryControl"
                                                                              VerticalAlignment="Top"
                                                                              Value="0"
                                                                              Maximum="100"
                                                                              IsCharging="True"
                                                                              TemperatureText="0 °C"
                                                                              CenterShowsTemperature="False"
                                                                              Height="92"
                                                                              Margin="0,6,0,0"
                                                                              Loaded="BatteryControl_Loaded"/>
                                                </StackPanel>
                                            </Border>

                                            <Border x:Name="StorageMemoryBorder" Grid.Row="2" Style="{StaticResource HomeCardStyle}">
                                                <StackPanel>
                                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                                        <Border Width="28" Height="28" CornerRadius="8" Background="#FFE8F0FF">
                                                            <svg:SvgViewbox Source="images/shancun.svg" Width="16" Height="16"/>
                                                        </Border>
                                                        <TextBlock Style="{StaticResource HomePanelTitleStyle}" Text="存储与内存" VerticalAlignment="Center" Margin="10,0,0,0"/>
                                                    </StackPanel>
                                                    <Viewbox Stretch="Uniform" Margin="0,6,0,0">
                                                        <Grid Width="360" Height="200">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="*"/>
                                                            </Grid.ColumnDefinitions>
                                                            <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                                                                <Grid Width="138" Height="138">
                                                                    <Ellipse Stroke="#FFE5E5EA" StrokeThickness="12" Stretch="Uniform"/>
                                                                    <Ellipse Stroke="{StaticResource StorageGradient}" StrokeThickness="{Binding StrokeThickness}" Stretch="Uniform" StrokeDashArray="{Binding StorageDashArray}" StrokeDashCap="Round" StrokeDashOffset="0">
                                                                        <Ellipse.RenderTransform>
                                                                            <RotateTransform Angle="-90" CenterX="69" CenterY="69"/>
                                                                        </Ellipse.RenderTransform>
                                                                    </Ellipse>
                                                                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                                                        <TextBlock Text="{Binding StorageUsage, StringFormat={}{0:F1}%}" HorizontalAlignment="Center" FontSize="23" FontWeight="Bold" Foreground="#FF1D1D1F"/>
                                                                        <TextBlock Text="{Binding StorageText}" HorizontalAlignment="Center" FontSize="11" Foreground="#FF8E8E93" Margin="0,4,0,0"/>
                                                                    </StackPanel>
                                                                </Grid>
                                                                <TextBlock Text="内部存储" HorizontalAlignment="Center" FontSize="15" FontWeight="SemiBold" Margin="0,12,0,0" Foreground="#FF3A3A3C"/>
                                                            </StackPanel>
                                                            <StackPanel Grid.Column="1" HorizontalAlignment="Center">
                                                                <Grid Width="138" Height="138">
                                                                    <Ellipse Stroke="#FFE5E5EA" StrokeThickness="12" Stretch="Uniform"/>
                                                                    <Ellipse Stroke="{StaticResource MemoryGradient}" StrokeThickness="{Binding StrokeThickness}" Stretch="Uniform" StrokeDashArray="{Binding MemoryDashArray}" StrokeDashCap="Round" StrokeDashOffset="0">
                                                                        <Ellipse.RenderTransform>
                                                                            <RotateTransform Angle="-90" CenterX="69" CenterY="69"/>
                                                                        </Ellipse.RenderTransform>
                                                                    </Ellipse>
                                                                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                                                        <TextBlock Text="{Binding MemoryUsage, StringFormat={}{0:F1}%}" HorizontalAlignment="Center" FontSize="23" FontWeight="Bold" Foreground="#FF48484A"/>
                                                                        <TextBlock Text="{Binding MemoryText}" HorizontalAlignment="Center" FontSize="11" Foreground="#FF8E8E93" Margin="0,4,0,0"/>
                                                                    </StackPanel>
                                                                </Grid>
                                                                <TextBlock Text="运行内存" HorizontalAlignment="Center" FontSize="15" FontWeight="SemiBold" Margin="0,12,0,0" Foreground="#FF3A3A3C"/>
                                                            </StackPanel>
                                                        </Grid>
                                                    </Viewbox>
                                                </StackPanel>
                                            </Border>
                                        </Grid>
                                    </Grid>

                                    <!-- 第二行：快捷重启 + 快捷工具 -->
                                    <Border Style="{StaticResource HomeCardStyle}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="1.2*" />
                                                <ColumnDefinition Width="16" />
                                                <ColumnDefinition Width="0.95*" />
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Grid.Column="0">
                                                <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                                                    <Border Width="28" Height="28" CornerRadius="8" Background="#FF007AFF">
                                                        <svg:SvgViewbox Source="images/white/zhongqi.svg" Width="16" Height="16"/>
                                                    </Border>
                                                    <TextBlock Style="{StaticResource HomePanelTitleStyle}" Text="快捷重启" VerticalAlignment="Center" Margin="10,0,0,0"/>
                                                </StackPanel>
                                                <UniformGrid Columns="2" Margin="0,0,0,0">
                                                    <Button x:Name="RebootPhoneButton" Click="RebootPhoneButton_Click" Style="{StaticResource HomeActionButtonStyle}" Margin="0,0,8,10">
                                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                            <svg:SvgViewbox Source="images/white/zhongqi.svg" Width="15" Height="15" Margin="0,0,6,0"/>
                                                            <TextBlock Text="系统" VerticalAlignment="Center"/>
                                                        </StackPanel>
                                                    </Button>
                                                    <Button x:Name="RebootToFastbootButton" Click="RebootToFastbootButton_Click" Style="{StaticResource HomeActionButtonStyle}" Margin="8,0,0,10">
