<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:System="clr-namespace:System;assembly=mscorlib">

    <!-- ============================================ -->
    <!-- VioletToolBox - macOS Apple Design Theme      -->
    <!-- ============================================ -->

    <!-- System Blue (macOS accent) -->
    <Color x:Key="Violet50">#FFE8F0FF</Color>
    <Color x:Key="Violet100">#FFD1E2FF</Color>
    <Color x:Key="Violet200">#FF99C2FF</Color>
    <Color x:Key="Violet300">#FF4D9DFF</Color>
    <Color x:Key="Violet400">#FF1A85FF</Color>
    <Color x:Key="Violet500">#FF007AFF</Color>
    <Color x:Key="Violet600">#FF0066D6</Color>
    <Color x:Key="Violet700">#FF004C9E</Color>
    <Color x:Key="Violet800">#FF003A78</Color>
    <Color x:Key="Violet900">#FF002A57</Color>

    <!-- Neutrals (macOS grays) -->
    <Color x:Key="Gray25">#FFFFFFFF</Color>
    <Color x:Key="Gray50">#FFF5F5F7</Color>
    <Color x:Key="Gray75">#FFEFEFF4</Color>
    <Color x:Key="Gray100">#FFE5E5EA</Color>
    <Color x:Key="Gray200">#FFD1D1D6</Color>
    <Color x:Key="Gray300">#FFC7C7CC</Color>
    <Color x:Key="Gray400">#FFAEAEB2</Color>
    <Color x:Key="Gray500">#FF8E8E93</Color>
    <Color x:Key="Gray600">#FF636366</Color>
    <Color x:Key="Gray700">#FF48484A</Color>
    <Color x:Key="Gray800">#FF3A3A3C</Color>
    <Color x:Key="Gray900">#FF1D1D1F</Color>

    <!-- Semantic (macOS system colors) -->
    <Color x:Key="Success500">#FF34C759</Color>
    <Color x:Key="Warning500">#FFFF9500</Color>
    <Color x:Key="Error500">#FFFF3B30</Color>
    <Color x:Key="Info500">#FF007AFF</Color>
    <Color x:Key="Success100">#FFE8F9ED</Color>
    <Color x:Key="Warning100">#FFFFF4E0</Color>
    <Color x:Key="Error100">#FFFEE8E6</Color>
    <Color x:Key="Info100">#FFD1E2FF</Color>

    <!-- Brushes -->
    <SolidColorBrush x:Key="BrandPrimaryBrush" Color="{StaticResource Violet500}"/>
    <SolidColorBrush x:Key="BrandPrimaryHoverBrush" Color="{StaticResource Violet600}"/>
    <Color x:Key="BrandPressedColor">#FF004C9E</Color>
    <SolidColorBrush x:Key="BrandPrimaryPressedBrush" Color="{StaticResource Violet700}"/>
    <SolidColorBrush x:Key="BrandSecondaryBrush" Color="{StaticResource Violet100}"/>
    <SolidColorBrush x:Key="BrandTintBrush" Color="{StaticResource Violet50}"/>
    <SolidColorBrush x:Key="BrandTintStrongBrush" Color="{StaticResource Violet100}"/>

    <SolidColorBrush x:Key="BackgroundBrush" Color="{StaticResource Gray50}"/>
    <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource Gray25}"/>
    <SolidColorBrush x:Key="SurfaceSecondaryBrush" Color="{StaticResource Gray75}"/>
    <SolidColorBrush x:Key="SurfaceTintBrush" Color="{StaticResource Gray50}"/>
    <SolidColorBrush x:Key="SurfaceHoverBrush" Color="{StaticResource Gray100}"/>
    <SolidColorBrush x:Key="SurfacePressedBrush" Color="{StaticResource Gray200}"/>
    <SolidColorBrush x:Key="SidebarBackgroundBrush" Color="#FFF5F5F7"/>
    <SolidColorBrush x:Key="SidebarHoverBrush" Color="#FFE5E5EA"/>
    <SolidColorBrush x:Key="SidebarSelectedBrush" Color="{StaticResource Violet500}"/>

    <SolidColorBrush x:Key="TextStrongBrush" Color="{StaticResource Gray800}"/>
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource Gray900}"/>
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource Gray600}"/>
    <SolidColorBrush x:Key="TextMutedBrush" Color="{StaticResource Gray500}"/>
    <SolidColorBrush x:Key="TextTertiaryBrush" Color="{StaticResource Gray400}"/>
    <SolidColorBrush x:Key="TextDisabledBrush" Color="{StaticResource Gray300}"/>
    <SolidColorBrush x:Key="TextOnPrimaryBrush" Color="White"/>
    <SolidColorBrush x:Key="TextOnBrandBrush" Color="White"/>

    <SolidColorBrush x:Key="BorderSubtleBrush" Color="{StaticResource Gray100}"/>
    <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource Gray200}"/>
    <SolidColorBrush x:Key="BorderStrongBrush" Color="{StaticResource Gray300}"/>
    <SolidColorBrush x:Key="SeparatorBrush" Color="{StaticResource Gray100}"/>

    <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource Success500}"/>
    <SolidColorBrush x:Key="SuccessTintBrush" Color="{StaticResource Success100}"/>
    <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource Warning500}"/>
    <SolidColorBrush x:Key="WarningTintBrush" Color="{StaticResource Warning100}"/>
    <SolidColorBrush x:Key="ErrorBrush" Color="{StaticResource Error500}"/>
    <SolidColorBrush x:Key="ErrorTintBrush" Color="{StaticResource Error100}"/>
    <SolidColorBrush x:Key="InfoBrush" Color="{StaticResource Info500}"/>
    <SolidColorBrush x:Key="InfoTintBrush" Color="{StaticResource Info100}"/>

    <SolidColorBrush x:Key="IconPrimaryBrush" Color="{StaticResource Gray600}"/>
    <SolidColorBrush x:Key="IconOnBrandBrush" Color="White"/>

    <FontFamily x:Key="DefaultFontFamily">OPPO Sans 4.0, SF Pro Display, SF Pro Text, PingFang SC, Segoe UI Variable Display, Segoe UI, Microsoft YaHei UI, sans-serif</FontFamily>
    <FontFamily x:Key="MonoFontFamily">SF Mono, Cascadia Mono, Consolas, Menlo, Microsoft YaHei UI</FontFamily>

    <System:Double x:Key="FontSizeCaption">11</System:Double>
    <System:Double x:Key="FontSizeSmall">12</System:Double>
    <System:Double x:Key="FontSizeNormal">13</System:Double>
    <System:Double x:Key="FontSizeBody">13</System:Double>
    <System:Double x:Key="FontSizeLarge">15</System:Double>
    <System:Double x:Key="FontSizeTitle">17</System:Double>
    <System:Double x:Key="FontSizeHeadline">20</System:Double>
    <System:Double x:Key="FontSizeDisplay">26</System:Double>

    <Thickness x:Key="SpacingXS">4</Thickness>
    <Thickness x:Key="SpacingSM">8</Thickness>
    <Thickness x:Key="SpacingMD">12</Thickness>
    <Thickness x:Key="SpacingLG">16</Thickness>
    <Thickness x:Key="SpacingXL">20</Thickness>
    <Thickness x:Key="SpacingXXL">28</Thickness>

    <CornerRadius x:Key="RadiusSM">5</CornerRadius>
    <CornerRadius x:Key="RadiusMD">6</CornerRadius>
    <CornerRadius x:Key="RadiusLG">10</CornerRadius>
    <CornerRadius x:Key="RadiusXL">12</CornerRadius>
    <CornerRadius x:Key="RadiusXXL">16</CornerRadius>

    <!-- Neutral gray shadows (macOS style, no blue tint) -->
    <DropShadowEffect x:Key="ShadowCard" Color="#FF000000" Opacity="0.04" BlurRadius="12" ShadowDepth="0" Direction="270"/>
    <DropShadowEffect x:Key="ShadowCardHover" Color="#FF000000" Opacity="0.08" BlurRadius="16" ShadowDepth="2" Direction="270"/>
    <DropShadowEffect x:Key="ShadowButton" Color="#FF000000" Opacity="0.10" BlurRadius="4" ShadowDepth="1" Direction="270"/>
    <DropShadowEffect x:Key="ShadowBrand" Color="{StaticResource Violet500}" Opacity="0.20" BlurRadius="12" ShadowDepth="2" Direction="270"/>
    <DropShadowEffect x:Key="ShadowPopup" Color="#FF000000" Opacity="0.15" BlurRadius="20" ShadowDepth="4" Direction="270"/>
    <DropShadowEffect x:Key="ShadowSidebar" Color="#FF000000" Opacity="0.05" BlurRadius="12" ShadowDepth="2" Direction="270"/>

    <!-- HC Theme Override -->
    <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource Violet500}"/>
    <SolidColorBrush x:Key="PrimaryColor" Color="{StaticResource Violet500}"/>
    <SolidColorBrush x:Key="PrimaryTextBrush" Color="White"/>
    <SolidColorBrush x:Key="DarkPrimaryBrush" Color="{StaticResource Violet600}"/>
    <SolidColorBrush x:Key="DarkPrimaryColor" Color="{StaticResource Violet600}"/>
    <SolidColorBrush x:Key="LightPrimaryBrush" Color="{StaticResource Violet100}"/>
    <SolidColorBrush x:Key="SecondaryBrush" Color="{StaticResource Violet500}"/>
    <SolidColorBrush x:Key="SecondaryTextBrush" Color="{StaticResource Violet700}"/>
    <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource Error500}"/>
    <SolidColorBrush x:Key="DangerColor" Color="{StaticResource Error500}"/>
    <SolidColorBrush x:Key="PrimaryHoverBrush" Color="{StaticResource Violet600}"/>
    <SolidColorBrush x:Key="PrimaryPressedBrush" Color="{StaticResource Violet700}"/>
    <SolidColorBrush x:Key="DangerHoverBrush" Color="#FFFF6B60"/>
    <SolidColorBrush x:Key="DangerPressedBrush" Color="#FFFF3B30"/>
    <SolidColorBrush x:Key="PrimaryBorderBrush" Color="{StaticResource Violet500}"/>
    <SolidColorBrush x:Key="PrimaryColorFrozen" Color="{StaticResource Violet500}"/>
</ResourceDictionary>
